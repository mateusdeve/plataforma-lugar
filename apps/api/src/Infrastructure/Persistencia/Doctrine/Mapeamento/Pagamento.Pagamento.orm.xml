<?xml version="1.0" encoding="utf-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="Lugar\Domain\Pagamento\Pagamento" table="pagamento">
        <unique-constraints>
            <!--
              ═══════════════════════════════════════════════════════════════
              O QUE IMPEDE INGRESSO DUPLICADO.

              Gateway de pagamento entrega webhook "pelo menos uma vez": o
              mesmo evento chega de novo por timeout, por retentativa, por
              política do provedor. Sem esta restrição, cada reentrega emitiria
              outra leva de ingressos para uma compra só.

              A consulta por provedor_id no caso de uso resolve o caso comum.
              Duas entregas SIMULTÂNEAS passam por ela juntas — e aí é este
              índice que faz o segundo INSERT falhar. A garantia é do banco.
              ═══════════════════════════════════════════════════════════════
            -->
            <unique-constraint name="uniq_pagamento_provedor" columns="provedor_id"/>
        </unique-constraints>

        <id name="id" type="pagamento_id"/>

        <!-- Por identidade, nunca por objeto (ADR-001). -->
        <field name="reservaId" column="reserva_id" type="reserva_id"/>

        <field name="provedorId" column="provedor_id" type="string" length="180"/>
        <field name="status" type="string" length="20" enum-type="Lugar\Domain\Pagamento\StatusDoPagamento"/>
        <!--
          `text`, e não `json`: guardamos os BYTES que o provedor mandou.
          O tipo `json` do Doctrine reserializa, e JSONB no Postgres normaliza
          chaves e espaços — os dois destroem a única coisa que esta coluna
          existe para preservar. Ver Version20260719160000.
        -->
        <field name="payloadBruto" column="payload_bruto" type="text"/>
        <field name="recebidoEm" column="recebido_em" type="datetime_immutable"/>

        <embedded name="valor" class="Lugar\Domain\Comum\Dinheiro" column-prefix="valor_"/>
    </entity>
</doctrine-mapping>
